model Media {
  id       BigInt  @id @default(autoincrement())
  url      String
  mimeType String? @map("mime_type")
  alt      String?
  width    Int?
  height   Int?
  collectionCovers Collection[] @relation("CollectionCoverMedia")
  postcardCovers   Postcard[]   @relation("PostcardCoverMedia")
  userProfilePics  User[]       @relation("UserProfilePic")
  userCoverImages  User[]       @relation("UserCoverImage")
  memoryGalleries  Memory[]     @relation("MemoryGallery")
  companyIcons     Company[]    @relation("CompanyIcon")
  @@map("media")
}

model Enquiry {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @map("user_id")
  subcollectionId BigInt   @map("subcollection_id")
  message         String?
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcollection Subcollection @relation(fields: [subcollectionId], references: [id], onDelete: Cascade)
  circles       Circle[]
  @@index([userId])
  @@index([subcollectionId])
  @@map("enquiries")
}