// =============================================================================
// Postcard Travel Club — Prisma Schema
// Generated from: Domain Model Diagrams (9 July 2026)
//
// Notes on translation decisions:
// - Provider: PostgreSQL (pgvector extension needed for UserPersona.preference_embedding)
// - Polymorphic relations (FacetAssignment, CollectionClusterEntry, Circle,
//   UserEvent.subject) are modeled as enum + BigInt id WITHOUT a Prisma relation,
//   since Prisma does not support polymorphic FKs. Integrity for these must be
//   enforced at the application/service layer.
// - "Embedded components" from the doc (location, seo, event_details, social,
//   tracking, best_months) are modeled as Json fields.
// - Media and Enquiry are referenced by the doc but not defined in it — minimal
//   stub models are included so relations resolve; extend as needed.
// - Model/field names are camelCase per Prisma convention, mapped to snake_case
//   tables/columns via @map/@@map.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

/// Editorial workflow for content entities ("the real production editorial workflow")
enum ContentStatus {
  draft
  assigned
  submit
  rework
  live
}

enum CompanyStatus {
  pending
  active
  suspended
}

/// Member-specific subscription tier
enum UserTier {
  free
  star_life
}

/// Doc specifies status as enum without listing values — adjust as needed
enum UserRoleStatus {
  active
  suspended
  revoked
}

/// What kind of entity a FacetAssignment applies to
enum FacetOwnedType {
  collection
  postcard
}

/// What kind of entry a CollectionClusterEntry points at
enum ClusterEntryType {
  collection
  postcard
}

/// Every ownable/followable entity type in the system (Circle.owned_type)
enum CircleOwnedType {
  postcard
  collection
  subcollection
  collection_cluster
  tag
  company
  user
}

/// author/assigned_staff = content stewardship; owner = business ownership;
/// bookmark/booked = member engagement
enum CircleRelationship {
  author
  assigned_staff
  owner
  bookmark
  booked
}

enum ShareType {
  private
  public
  selected
}

enum UserEventType {
  postcard_view
  collection_view
  search
  bookmark
  enquiry_submitted
  memory_created
  tag_click
}

/// UserEvent.subject_type — polymorphic subject of a behavioral event
enum EventSubjectType {
  postcard
  collection
  subcollection
  collection_cluster
  tag
  company
  user
}

enum PriceAffinity {
  budget
  mid
  luxury
}

model Example {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
}
// =============================================================================
// CONTENT HIERARCHY
// =============================================================================

model CollectionType {
  id                     BigInt  @id @default(autoincrement())
  name                   String // Properties, Restaurants, Events, Shopping, Destination Expert
  slug                   String  @unique
  description            String?
  icon                   String?
  /// true only for types with a real Collection layer (Properties, Destination Expert)
  hasDedicatedCollection Boolean @default(false) @map("has_dedicated_collection")
  /// display order
  priority               Int     @default(0)
  collections        Collection[]
  postcards          Postcard[]
  subcollectionTypes SubcollectionType[]
  facetTypes         FacetType[]
  @@map("collection_types")
}

model Collection {
  id                 BigInt        @id @default(autoincrement())
  collectionTypeId   BigInt        @map("collection_type_id")
  name               String
  intro              String?
  /// richtext
  story              String?
  slug               String        @unique
  coverMediaId       BigInt?       @map("cover_media_id")
  /// embedded component: meta title, description, OG image
  seo                Json?
  isFeatured         Boolean       @default(false) @map("is_featured")
  priority           Int           @default(0)
  countryId          BigInt?       @map("country_id")
  regionId           BigInt?       @map("region_id")
  cityId             BigInt?       @map("city_id")
  localityId         BigInt?       @map("locality_id")
  /// embedded: address, lat, lng, google_place_id
  location           Json?
  /// the corporate/billing entity, if any
  managedByCompanyId BigInt?       @map("managed_by_company_id")
  website            String?
  mediaKit           String?       @map("media_kit")
  additionalInfo     String?       @map("additional_info")
  sustainability     String?
  status             ContentStatus @default(draft)
  collectionType   CollectionType @relation(fields: [collectionTypeId], references: [id])
  coverMedia       Media?         @relation("CollectionCoverMedia", fields: [coverMediaId], references: [id])
  country          Country?       @relation(fields: [countryId], references: [id])
  region           Region?        @relation(fields: [regionId], references: [id])
  city             City?          @relation(fields: [cityId], references: [id])
  locality         Locality?      @relation(fields: [localityId], references: [id])
  managedByCompany Company?       @relation(fields: [managedByCompanyId], references: [id])
  postcards      Postcard[]
  subcollections Subcollection[]
  // Sub-type classification (Boutique Stays, Signature Experiences, Cuisine)
  // lives in FacetAssignment (owned_type = collection) — polymorphic, no direct relation.
  @@index([collectionTypeId])
  @@index([countryId, regionId, cityId, localityId])
  @@map("collections")
}

model Postcard {
  id               BigInt        @id @default(autoincrement())
  name             String
  intro            String?
  slug             String        @unique
  /// richtext
  story            String?
  /// always populated
  collectionTypeId BigInt        @map("collection_type_id")
  /// populated only when CollectionType.has_dedicated_collection = true
  collectionId     BigInt?       @map("collection_id")
  /// geo set directly when collection_id is null (Restaurants/Events/Shopping)
  countryId        BigInt?       @map("country_id")
  regionId         BigInt?       @map("region_id")
  cityId           BigInt?       @map("city_id")
  localityId       BigInt?       @map("locality_id")
  /// embedded: set directly for Restaurants/Shopping postcards
  location         Json?
  /// Events only: start_date, end_date, is_recurring, recurrence_rule, venue
  eventDetails     Json?         @map("event_details")
  copyright        String?
  isFeatured       Boolean       @default(false) @map("is_featured")
  priority         Int           @default(0)
  coverMediaId     BigInt?       @map("cover_media_id")
  status           ContentStatus @default(draft)
  publishedAt      DateTime?     @map("published_at")
  collectionType CollectionType @relation(fields: [collectionTypeId], references: [id])
  collection     Collection?    @relation(fields: [collectionId], references: [id])
  coverMedia     Media?         @relation("PostcardCoverMedia", fields: [coverMediaId], references: [id])
  country        Country?       @relation(fields: [countryId], references: [id])
  region         Region?        @relation(fields: [regionId], references: [id])
  city           City?          @relation(fields: [cityId], references: [id])
  locality       Locality?      @relation(fields: [localityId], references: [id])
  /// M2M -> Tag (granular postcard-level features)
  tags                 Tag[]                   @relation("PostcardTags")
  subcollectionEntries SubcollectionPostcard[]
  memories             Memory[]
  @@index([collectionId])
  @@index([collectionTypeId])
  @@index([countryId, regionId, cityId, localityId])
  @@map("postcards")
}

// =============================================================================
// SUBCOLLECTION & COLLECTION CLUSTER
// =============================================================================

model SubcollectionType {
  id               BigInt  @id @default(autoincrement())
  /// which CollectionType this subgrouping applies to (Properties -> Journey)
  collectionTypeId BigInt  @map("collection_type_id")
  name             String
  slug             String  @unique
  description      String?
  priority         Int     @default(0)
  collectionType CollectionType  @relation(fields: [collectionTypeId], references: [id])
  subcollections Subcollection[]
  @@map("subcollection_types")
}

model Subcollection {
  id                  BigInt        @id @default(autoincrement())
  subcollectionTypeId BigInt        @map("subcollection_type_id")
  /// required — the one Property this Journey belongs to
  collectionId        BigInt        @map("collection_id")
  name                String
  intro               String?
  /// richtext
  story               String?
  slug                String        @unique
  /// richtext
  tourInfo            String?       @map("tour_info")
  /// legacy avgPricePerPerson (dual-price fix: the two legacy prices stay separate)
  price               Decimal?      @db.Decimal(12, 2)
  /// legacy pricesStartingAt ("prices starting at" teaser price)
  priceStartingAt     Decimal?      @map("price_starting_at") @db.Decimal(12, 2)
  /// fixed from legacy string type
  numberOfNights      Int?          @map("number_of_nights")
  /// replaces the numberOfGuestsTitle/Value label-value hack
  guestsMin           Int?          @map("guests_min")
  guestsMax           Int?          @map("guests_max")
  /// embedded, repeatable
  bestMonths          Json?         @map("best_months")
  managedByCompanyId  BigInt?       @map("managed_by_company_id")
  status              ContentStatus @default(draft)
  subcollectionType SubcollectionType @relation(fields: [subcollectionTypeId], references: [id])
  collection        Collection        @relation(fields: [collectionId], references: [id])
  managedByCompany  Company?          @relation(fields: [managedByCompanyId], references: [id])
  postcards SubcollectionPostcard[]
  enquiries Enquiry[]
  @@index([collectionId])
  @@map("subcollections")
}

/// Ordered join. App-level invariant: postcard.collection_id must equal the
/// parent subcollection.collection_id (cannot be expressed in Prisma/SQL FK).
model SubcollectionPostcard {
  subcollectionId BigInt @map("subcollection_id")
  postcardId      BigInt @map("postcard_id")
  /// manually set display position (Day 1, Day 2...), not a calendar date.
  /// Real calendar dates are assigned per member when a Journey is booked
  /// (Circle.sequence_date).
  sequenceOrder   Int    @map("sequence_order")
  subcollection Subcollection @relation(fields: [subcollectionId], references: [id], onDelete: Cascade)
  postcard      Postcard      @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  @@id([subcollectionId, postcardId])
  @@index([subcollectionId, sequenceOrder])
  @@map("subcollection_postcards")
}

model CollectionClusterType {
  id          BigInt  @id @default(autoincrement())
  /// City Guide, Partner Affiliation
  name        String
  slug        String  @unique
  description String?
  priority    Int     @default(0)
  clusters CollectionCluster[]
  @@map("collection_cluster_types")
}

model CollectionCluster {
  id                 BigInt        @id @default(autoincrement())
  clusterTypeId      BigInt        @map("cluster_type_id")
  name               String
  slug               String        @unique
  intro              String?
  /// richtext
  story              String?
  /// geo meaningful for City Guide
  countryId          BigInt?       @map("country_id")
  regionId           BigInt?       @map("region_id")
  cityId             BigInt?       @map("city_id")
  localityId         BigInt?       @map("locality_id")
  /// meaningful for Partner Affiliation
  managedByCompanyId BigInt?       @map("managed_by_company_id")
  status             ContentStatus @default(draft)
  clusterType      CollectionClusterType @relation(fields: [clusterTypeId], references: [id])
  country          Country?              @relation(fields: [countryId], references: [id])
  region           Region?               @relation(fields: [regionId], references: [id])
  city             City?                 @relation(fields: [cityId], references: [id])
  locality         Locality?             @relation(fields: [localityId], references: [id])
  managedByCompany Company?              @relation(fields: [managedByCompanyId], references: [id])
  entries CollectionClusterEntry[]
  @@map("collection_clusters")
}

/// Polymorphic join: entry_id points at Collection.id OR Postcard.id depending
/// on entry_type. No DB-level FK — enforce in the service layer.
model CollectionClusterEntry {
  id        BigInt           @id @default(autoincrement())
  clusterId BigInt           @map("cluster_id")
  entryType ClusterEntryType @map("entry_type")
  entryId   BigInt           @map("entry_id")
  /// curator-controlled display order
  priority  Int              @default(0)
  cluster CollectionCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  @@unique([clusterId, entryType, entryId])
  @@index([entryType, entryId])
  @@map("collection_cluster_entries")
}

// =============================================================================
// GEO HIERARCHY (Country -> Region -> City -> Locality)
// Each tier uniquely scoped to its parent, not globally unique.
// =============================================================================

model Country {
  id   BigInt @id @default(autoincrement())
  name String @unique
  slug String @unique
  regions            Region[]
  collections        Collection[]
  postcards          Postcard[]
  collectionClusters CollectionCluster[]
  users              User[]
  memories           Memory[]
  @@map("countries")
}

model Region {
  id        BigInt @id @default(autoincrement())
  countryId BigInt @map("country_id")
  name      String
  slug      String
  country Country @relation(fields: [countryId], references: [id])
  cities             City[]
  collections        Collection[]
  postcards          Postcard[]
  collectionClusters CollectionCluster[]
  users              User[]
  memories           Memory[]
  @@unique([name, countryId])
  @@map("regions")
}

model City {
  id       BigInt   @id @default(autoincrement())
  regionId BigInt   @map("region_id")
  name     String
  slug     String
  /// centroid, for map default zoom
  lat      Decimal? @db.Decimal(9, 6)
  lng      Decimal? @db.Decimal(9, 6)
  region Region @relation(fields: [regionId], references: [id])
  localities         Locality[]
  collections        Collection[]
  postcards          Postcard[]
  collectionClusters CollectionCluster[]
  users              User[]
  memories           Memory[]
  @@unique([name, regionId])
  @@map("cities")
}

model Locality {
  id     BigInt   @id @default(autoincrement())
  cityId BigInt   @map("city_id")
  name   String
  slug   String
  /// optional centroid
  lat    Decimal? @db.Decimal(9, 6)
  lng    Decimal? @db.Decimal(9, 6)
  city City @relation(fields: [cityId], references: [id])
  collections        Collection[]
  postcards          Postcard[]
  collectionClusters CollectionCluster[]
  users              User[]
  memories           Memory[]
  @@unique([name, cityId])
  @@map("localities")
}

// =============================================================================
// CLASSIFICATION (Facets & Tags)
// The single classification mechanism — new dimensions are new FacetType rows,
// never schema changes.
// =============================================================================

model FacetType {
  id                        BigInt  @id @default(autoincrement())
  /// Property Type, Experience Theme, Cuisine...
  name                      String
  slug                      String  @unique
  /// scopes relevance; null = applies broadly
  appliesToCollectionTypeId BigInt? @map("applies_to_collection_type_id")
  /// single-select (Property Type) vs multi-select (Cuisine)
  allowsMultiple            Boolean @default(false) @map("allows_multiple")
  appliesToCollectionType CollectionType? @relation(fields: [appliesToCollectionTypeId], references: [id])
  values                  FacetValue[]
  @@map("facet_types")
}

model FacetValue {
  id          BigInt @id @default(autoincrement())
  facetTypeId BigInt @map("facet_type_id")
  /// e.g. Glamping, Cultural, Indian, Boutique Stays, Signature Experiences
  name        String
  slug        String
  facetType   FacetType         @relation(fields: [facetTypeId], references: [id])
  assignments FacetAssignment[]
  @@unique([facetTypeId, slug])
  @@map("facet_values")
}

/// Polymorphic join: owned_id points at Collection.id OR Postcard.id depending
/// on owned_type. No DB-level FK — enforce in the service layer.
/// This is the single mechanism for sub-type classification (the earlier
/// Category/CollectionCategory entities were removed as duplicates).
model FacetAssignment {
  id           BigInt         @id @default(autoincrement())
  ownedType    FacetOwnedType @map("owned_type")
  ownedId      BigInt         @map("owned_id")
  facetValueId BigInt         @map("facet_value_id")
  facetValue FacetValue @relation(fields: [facetValueId], references: [id], onDelete: Cascade)
  @@unique([ownedType, ownedId, facetValueId])
  @@index([ownedType, ownedId])
  @@map("facet_assignments")
}

model Tag {
  id   BigInt @id @default(autoincrement())
  /// granular postcard-level features: stargazing, infinity pool
  name String @unique
  slug String @unique
  postcards       Postcard[]       @relation("PostcardTags")
  userPersonaTags UserPersonaTag[]
  @@map("tags")
}

// =============================================================================
// ACTORS
// =============================================================================

model Company {
  id           BigInt        @id @default(autoincrement())
  name         String
  slug         String        @unique
  contactEmail String?       @map("contact_email")
  contactPhone String?       @map("contact_phone")
  website      String?
  iconMediaId  BigInt?       @map("icon_media_id")
  status       CompanyStatus @default(pending)
  iconMedia Media? @relation("CompanyIcon", fields: [iconMediaId], references: [id])
  collections        Collection[]
  subcollections     Subcollection[]
  collectionClusters CollectionCluster[]
  userRoles          UserRole[]
  @@map("companies")
}

model UserType {
  id        BigInt  @id @default(autoincrement())
  /// Member, Partner, Staff Editor, Admin
  name      String
  slug      String  @unique
  /// ordinary member
  isDefault Boolean @default(false) @map("is_default")
  /// can author/submit content
  isCreator Boolean @default(false) @map("is_creator")
  /// admin-level access
  isAdmin   Boolean @default(false) @map("is_admin")
  userRoles UserRole[]
  @@map("user_types")
}

model User {
  id            BigInt    @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  /// legacy Strapi uid (from fullName) — public profile URL identifier
  slug          String?   @unique

  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  /// replaces Strapi's users-permissions plugin
  passwordHash  String?   @map("password_hash")
  authProvider  String?   @map("auth_provider")
  providerId    String?   @map("provider_id")
  emailVerified Boolean   @default(false) @map("email_verified")
  isBlocked     Boolean   @default(false) @map("is_blocked")
  profilePicId  BigInt?   @map("profile_pic_id")
  coverImageId  BigInt?   @map("cover_image_id")
  /// richtext
  bio           String?
  /// embedded components
  social        Json?
  seo           Json?
  tracking      Json?
  /// for public creator/destination-expert profiles
  isFeatured    Boolean   @default(false) @map("is_featured")
  priority      Int       @default(0)
  countryId     BigInt?   @map("country_id")
  regionId      BigInt?   @map("region_id")
  cityId        BigInt?   @map("city_id")
  localityId    BigInt?   @map("locality_id")
  /// Member-specific
  tier          UserTier?
  /// Admin access flag
  isAdmin       Boolean   @default(false) @map("is_admin")
  profilePic Media?    @relation("UserProfilePic", fields: [profilePicId], references: [id])
  coverImage Media?    @relation("UserCoverImage", fields: [coverImageId], references: [id])
  country    Country?  @relation(fields: [countryId], references: [id])
  region     Region?   @relation(fields: [regionId], references: [id])
  city       City?     @relation(fields: [cityId], references: [id])
  locality   Locality? @relation(fields: [localityId], references: [id])
  roles        UserRole[]       @relation("UserRoles")
  managedRoles UserRole[]       @relation("RoleManager")
  circles      Circle[]
  memories     Memory[]         @relation("UserMemories")
  taggedIn     Memory[]         @relation("MemoryTaggedUsers")
  events       UserEvent[]
  enquiries    Enquiry[]
  responses    Response[]       @relation("UserResponses")
  persona      UserPersona?
  personaTags  UserPersonaTag[]
  @@map("users")
}

/// Replaces a single user_type_id column — one person can hold multiple roles
/// (e.g. a Partner who is also a personal Member, or a Partner managing
/// listings for two different Companies).
model UserRole {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  userTypeId    BigInt         @map("user_type_id")
  /// only for partner-type roles; supports multiple Companies per person
  companyId     BigInt?        @map("company_id")
  /// self-referential org hierarchy (Editor -> Editor-in-Chief)
  managerUserId BigInt?        @map("manager_user_id")
  grantedAt     DateTime       @default(now()) @map("granted_at")
  status        UserRoleStatus @default(active)
  user     User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  userType UserType @relation(fields: [userTypeId], references: [id])
  company  Company? @relation(fields: [companyId], references: [id])
  manager  User?    @relation("RoleManager", fields: [managerUserId], references: [id])
  @@index([userId])
  @@index([companyId])
  @@map("user_roles")
}

// =============================================================================
// CIRCLE — the universal relationship layer
// Replaces Bookmark, FollowAlbum, FollowCompany, FollowAffiliate, FollowTag,
// FollowCityGuide, and User-follows-User.
// =============================================================================

/// Polymorphic: owned_id points at the table indicated by owned_type
/// (postcard / collection / subcollection / collection_cluster / tag /
/// company / user). No DB-level FK — enforce in the service layer.
model Circle {
  id              BigInt             @id @default(autoincrement())
  userId          BigInt             @map("user_id")
  ownedType       CircleOwnedType    @map("owned_type")
  ownedId         BigInt             @map("owned_id")
  relationship    CircleRelationship
  /// only when relationship = booked
  sourceEnquiryId BigInt?            @map("source_enquiry_id")
  /// only for booked postcards inside a forked Journey (real calendar date)
  sequenceDate    DateTime?          @map("sequence_date") @db.Date
  addedAt         DateTime           @default(now()) @map("added_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEnquiry Enquiry? @relation(fields: [sourceEnquiryId], references: [id])
  @@unique([userId, ownedType, ownedId, relationship])
  /// "properly indexed on (user_id, relationship, owned_type)" — answers every
  /// variant of "show me everything connected to this person"
  @@index([userId, relationship, ownedType])
  @@index([ownedType, ownedId])
  @@map("circles")
}

// =============================================================================
// GENERIC RESPONSES (form submissions, feedback, etc.)
// =============================================================================

model ResponseType {
  id          BigInt   @id @default(autoincrement())
  /// contact_form, feedback, newsletter_signup, review, etc.
  name        String   @unique
  slug        String   @unique
  description String?
  fields    ResponseField[]
  responses Response[]
  @@map("response_types")
}

/// Defines the fields/schema for each ResponseType
model ResponseField {
  id             BigInt  @id @default(autoincrement())
  responseTypeId BigInt  @map("response_type_id")
  /// field name: message, email, rating, subject, etc.
  fieldName      String  @map("field_name")
  /// string, number, email, phone, select, textarea, checkbox, etc.
  fieldType      String  @map("field_type")
  isRequired     Boolean @default(false) @map("is_required")
  placeholder    String?
  description    String?
  /// display order in form
  order          Int     @default(0)
  responseType ResponseType @relation(fields: [responseTypeId], references: [id], onDelete: Cascade)
  @@unique([responseTypeId, fieldName])
  @@map("response_fields")
}

/// Stores user-submitted responses/form submissions
model Response {
  id            BigInt    @id @default(autoincrement())
  responseTypeId BigInt   @map("response_type_id")
  userId        BigInt    @map("user_id")
  /// JSON object containing all field values {message: "...", email: "...", rating: 5}
  data          Json
  /// pending, reviewed, archived, spam, etc.
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  responseType ResponseType @relation(fields: [responseTypeId], references: [id], onDelete: Cascade)
  user         User          @relation("UserResponses", fields: [userId], references: [id], onDelete: Cascade)
  @@index([responseTypeId])
  @@index([userId, createdAt])
  @@map("responses")
}

// =============================================================================
// MEMORY & ANALYTICS
// =============================================================================

model Memory {
  id          BigInt    @id @default(autoincrement())
  /// creator/owner of the memory
  userId      BigInt    @map("user_id")
  /// null = standalone memory not tied to any postcard
  postcardId  BigInt?   @map("postcard_id")
  name        String
  slug        String    @unique
  intro       String?
  /// when the experience happened (distinct from created_at)
  memoryDate  DateTime? @map("memory_date") @db.Date
  /// copied from the postcard at creation, or set manually if standalone
  countryId   BigInt?   @map("country_id")
  regionId    BigInt?   @map("region_id")
  cityId      BigInt?   @map("city_id")
  localityId  BigInt?   @map("locality_id")
  externalUrl String?   @map("external_url")
  /// 'selected' = visible only to tagged users
  shareType   ShareType @default(private) @map("share_type")
  createdAt   DateTime  @default(now()) @map("created_at")
  user     User      @relation("UserMemories", fields: [userId], references: [id], onDelete: Cascade)
  postcard Postcard? @relation(fields: [postcardId], references: [id])
  country  Country?  @relation(fields: [countryId], references: [id])
  region   Region?   @relation(fields: [regionId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])
  locality Locality? @relation(fields: [localityId], references: [id])
  /// multiple photos/videos
  gallery     Media[] @relation("MemoryGallery")
  /// other people tagged in this memory
  taggedUsers User[]  @relation("MemoryTaggedUsers")
  @@index([userId])
  @@index([postcardId])
  @@map("memories")
}

/// Raw, append-only behavioral log
model UserEvent {
  id          BigInt            @id @default(autoincrement())
  userId      BigInt            @map("user_id")
  eventType   UserEventType     @map("event_type")
  /// polymorphic, nullable
  subjectType EventSubjectType? @map("subject_type")
  subjectId   BigInt?           @map("subject_id")
  /// populated when event_type = search
  searchQuery String?           @map("search_query")
  metadata    Json?
  occurredAt  DateTime          @default(now()) @map("occurred_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("user_events")
}

/// Periodically recomputed, derived profile (vs UserEvent's raw log)
model UserPersona {
  id             BigInt        @id @default(autoincrement())
  userId         BigInt        @unique @map("user_id")
  priceAffinity  PriceAffinity? @map("price_affinity")
  lastComputedAt DateTime?      @map("last_computed_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_personas")
}

/// Proper weighted join, not a JSON blob — queryable both ways:
/// a member's own top interests, and every member interested in a given tag.
model UserPersonaTag {
  userId    BigInt   @map("user_id")
  tagId     BigInt   @map("tag_id")
  weight    Decimal  @db.Decimal(6, 4)
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([userId, tagId])
  @@index([tagId, weight])
  @@map("user_persona_tags")
}

